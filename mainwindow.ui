        <property name="styleSheet">
         <string notr="true">/* Bouton arrondi avec image comme background */
#pushButton_8 {
    width: 100px;
    height: 40px;
    border-radius: 20px;              /* demi-hauteur → style pill */
    border: 1px solid rgba(255, 255, 255, 90);
    background-color: #5cb4f2;        /* couleur par défaut */
    background-image: url(:/images/icone.png); /* image */
    background-repeat: no-repeat;
    background-position: center;
    background-size: 20px 20px;       /* image plus petite que le bouton */
    color: white;
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    transition: all 0.3s ease;
    padding-left: 10px;                /* espace texte */
    padding-right: 10px;
}

/* Hover */
#pushButton_8:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5cb4f2, stop:1 #ffffff);
    color: #2f85c9;
}

