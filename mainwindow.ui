     <property name="styleSheet">
      <string notr="true">/* Bouton arrondi avec image comme background et couleurs inversées */
#pushButton_5_ressources {
    width: 100px;
    height: 40px;
    border-radius: 20px;                  /* demi-hauteur → style pill */
    border: 1px solid rgba(47, 133, 201, 90); /* inverse de l’original */
    background-color: #ffffff;            /* couleur inversée du fond */
    background-image: url(:/images/icone.png); /* image */
    background-repeat: no-repeat;
    background-position: center;
    background-size: 20px 20px;           /* image plus petite que le bouton */
    color: #5cb4f2;                        /* couleur texte inversée */
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    transition: all 0.3s ease;
    padding-left: 10px;                    /* espace texte */
    padding-right: 10px;
}

/* Hover inversé */
#pushButton_5_ressources:hover {
    background: #5cb4f2;                   /* couleur originale du fond */
    color: white;                           /* texte blanc sur hover */
}

/* Pressé inversé */
#pushButton_5_ressources:pressed {
    background-color: #ffffff;              /* couleur du fond inversée au clic */
    color: #2f85c9;                         /* texte bleu foncé au clic */
    transform: scale(0.95);
}</string>
