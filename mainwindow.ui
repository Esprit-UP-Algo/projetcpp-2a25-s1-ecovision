       <property name="styleSheet">
        <string notr="true">/* État normal (non sélectionné) : blanc */
QPushButton {
    background-color: #ffffff; 
    color: #3C9ED9; /* texte bleu ciel */
    border: 1px solid rgba(99, 184, 227, 0.9);
    border-radius: 5px;
    font-weight: bold;
}

/* Survol en état non sélectionné */
QPushButton:hover {
    background-color: #F2F9FE; /* léger bleu très clair */
}

/* Appuyé (momentané) */
QPushButton:pressed {
    background-color: #5CAFE3;
    color: white;
}

/* État sélectionné (si setCheckable(true)) */
QPushButton:checked {
    background-color: #87CEEB; /* bleu ciel */
    color: white;
    border-color: #5CAFE3;
}

/* Survol quand déjà sélectionné */
QPushButton:checked:hover {
    background-color: #5CAFE3; /* un peu plus foncé au survol */
    color: white;
}
</string>
