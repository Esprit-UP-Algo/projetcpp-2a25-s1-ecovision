        <property name="styleSheet">
         <string notr="true">/* Style de base pour la QGroupBox */
QGroupBox {
    border: 4px solid #999DF2; /* Bordure de la même couleur que le fond du titre */
    border-radius: 25px; /* Coins arrondis */
    margin-top: 10px; /* Marge en haut */
}

/* Style du titre de la QGroupBox */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 3px;
    background-color: #999DF2; /* Fond remplacé par #999DF2 */
    color: #ffffff; /* Texte blanc pour le titre */
    border-radius: 10px; /* Coins arrondis du titre */
}

/* Style des QLabel à l'intérieur de la QGroupBox */
QLabel {
    color: #000000; /* Couleur du texte */
}

/* Style des QRadioButton à l'intérieur de la QGroupBox */
QRadioButton {
    color: #333333; /* Couleur du texte */
}

/* Style des QComboBox à l'intérieur de la QGroupBox */
QComboBox {
    background-color: #ffffff; /* Fond blanc */
    color: #333333; /* Couleur du texte */
    border: 1px solid #3498db; /* Bordure bleue */
    border-radius: 3px; /* Coins arrondis */
    padding: 2px; /* Espacement interne */
}

/* Style des QLineEdit à l'intérieur de la QGroupBox */
QLineEdit {
    background-color: #ffffff; /* Fond blanc */
    color: #333333; /* Couleur du texte */
    border: 1px solid #3498db; /* Bordure bleue */
    border-radius: 3px; /* Coins arrondis */
    padding: 2px; /* Espacement interne */
}

/* Style des QSpinBox à l'intérieur de la QGroupBox */
QSpinBox {
    background-color: #ffffff; /* Fond blanc */
    color: #333333; /* Couleur du texte */
    border: 1px solid #3498db; /* Bordure bleue */
    border-radius: 3px; /* Coins arrondis */
    padding: 2px; /* Espacement interne */
}

/* Style général pour les widgets lorsqu'ils sont désactivés */
QWidget:disabled {
    background-color: #f0f0f0; /* Fond gris clair pour les widgets désactivés */
    color: #a0a0a0; /* Couleur du texte grise pour les widgets désactivés */
}</string>
