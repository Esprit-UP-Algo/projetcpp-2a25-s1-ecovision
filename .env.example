# .env.example
# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs
# Le fichier .env ne sera jamais commité dans Git (ajouté à .gitignore)

# Clé API Brevo (récupérez-la depuis votre compte Brevo)
BREVO_API_KEY=xkeysib-votre_cle_api_ici

# Email expéditeur vérifié dans Brevo
BREVO_SENDER_EMAIL=noreply@votre-domaine.com

# Mode mock pour tester sans envoyer de vrais emails (1 = activé, 0 ou vide = désactivé)
# BREVO_USE_MOCK=1
